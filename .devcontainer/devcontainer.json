{
  "name": "IOCL P0 Client Demo — Isolated Browser Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "IOCL Client Demo — private",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install --global bun@1.4.3 && bun install --frozen-lockfile",
  "containerEnv": {
    "ENVIRONMENT": "development"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
